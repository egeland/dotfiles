[alias]
	amend = "commit --amend -m"
	br = "branch"
	ca = "commit -am"
	cb = "checkout -b"
	ci = "commit --signoff"
	cm = "commit -m"
	co = "checkout"
	dc = "diff --cached"
	foreach = "submodule foreach"
	force-sweep = !git branch -vv | grep '\\[.*gone\\]' | awk '{print $1}' | xargs git branch -D
	lg = "log --oneline --abbrev-commit --all --graph --decorate --color --show-signature --no-merges"
	ll = "log --pretty=format:\"%C(yellow)%h%Cred%d\\\\ %Creset%s%Cblue\\\\ [%cn]\" --decorate --numstat"
	ls = "log --pretty=format:\"%C(yellow)%h%Cred%d\\\\ %Creset%s%Cblue\\\\ [%cn]\" --decorate"
	prp = "pull --rebase --prune"
	st = "status"
	sweep = !git branch -vv | grep '\\[.*gone\\]' | awk '{print $1}' | xargs git branch -d
	update = "submodule update --init --recursive"

[commit]
	gpgsign = true

[core]
	pager = "/opt/homebrew/bin/delta"

[delta]
	features = "side-by-side"
	light = false
	navigate = true

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[gpg]
	format = ssh

[gpg "openpgp"]
	program = "/opt/homebrew/bin/gpg"

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[init]
	defaultBranch = "main"

[interactive]
	diffFilter = "/opt/homebrew/bin/delta --color-only"

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[tag]
	gpgSign = false

[user]
	email = "egeland@gmail.com"
	name = "Frode Egeland"
	signingkey = ~/.ssh/id_ed25519.pub

[includeIf "gitdir:~/git_repos/"]
	path = "~/.config/git/work_config"
